---
import Layout from "@/layouts/Layout.astro"

const baseUrl = import.meta.env.BASE_URL
---

<Layout title="MITx Verified Certificate">
  <main class="page-shell">
    <header class="topbar">
      <a href={baseUrl}>Volver al portafolio</a>
      <a href={`${baseUrl}certificate`} target="_blank" rel="noopener noreferrer">Abrir en pestaña</a>
    </header>

    <section class="stage">
      <article class="certificate-sheet">
        <header class="certificate-head">
          <div class="verified-copy">
            <p class="verified-title">Verified</p>
            <p class="verified-subtitle">Certificate</p>
          </div>

          <div class="brand-block" aria-label="MITx">
            <div class="mit-mark" aria-hidden="true">
              <span class="b1"></span>
              <span class="b2"></span>
              <span class="b3"></span>
              <span class="b4"></span>
              <span class="b5"></span>
              <span class="b6"></span>
            </div>
            <div class="brand-text">
              <span>MITx</span>
            </div>
          </div>
        </header>

        <div class="watermark" aria-hidden="true">JAVIER HERNANDEZ MANCILLA</div>

        <div class="certificate-grid">
          <div class="main-copy">
            <p class="intro">This is to certify that</p>
            <h1>Javier Hernandez Mancilla</h1>
            <p class="completion">successfully completed and received a passing grade in</p>
            <h2>6.86x:Machine Learning with Python: from Linear Models to Deep Learning.</h2>
            <p class="description">
              a course of study offered by MITx, an online learning initiative of the
              Massachusetts Institute of Technology.
            </p>
          </div>

          <aside class="signature-panel">
            <div class="signature-card">
              <span class="signature" aria-hidden="true">Maurilio Puglisi</span>
              <strong>Maurilio Puglisi</strong>
              <small>Professor</small>
              <small class="org">UniversityX</small>
            </div>

            <div class="signature-card">
              <span class="signature" aria-hidden="true">Justine Doe</span>
              <strong>Justine Doe, Ph.D.</strong>
              <small>Professor</small>
              <small class="org">UniversityX</small>
            </div>
          </aside>
        </div>

        <footer class="certificate-foot">
          <div class="badge-area">
            <div class="seal" aria-hidden="true">
              <span>ed</span><span>X</span>
            </div>
            <div class="seal-copy">
              <strong>Verified Certificate</strong>
              <span>Valid Certificate ID</span>
            </div>
          </div>

          <dl class="meta-grid">
            <div>
              <dt>Issued Month / Year</dt>
              <dd>March 2025</dd>
            </div>

            <div>
              <dt>Certificate ID</dt>
              <dd>74f3c5e1a29b4d86a17c21f5a3e8d4b6</dd>
            </div>
          </dl>
        </footer>
      </article>
    </section>
  </main>
</Layout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: 2rem;
    background:
      radial-gradient(circle at top left, rgba(15, 97, 109, 0.08), transparent 28%),
      linear-gradient(180deg, #f2f5f6, #e9eeee);
  }

  .topbar {
    width: min(1120px, 100%);
    margin: 0 auto 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .topbar a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 47, 52, 0.14);
    background: rgba(255, 255, 255, 0.78);
    color: #102f34;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    backdrop-filter: blur(12px);
  }

  .stage {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .certificate-sheet {
    position: relative;
    overflow: hidden;
    aspect-ratio: 815 / 590;
    padding: 2rem 1.95rem 1.45rem;
    border: 2px solid #0d5b64;
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(244, 244, 239, 0.98)),
      #f3f3ef;
    box-shadow: 0 24px 48px rgba(18, 50, 55, 0.12);
  }

  .certificate-head {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
    margin-bottom: 1.55rem;
  }

  .verified-title,
  .verified-subtitle,
  .intro,
  .completion,
  .description,
  .seal-copy span,
  dt,
  dd,
  .brand-text span,
  .signature-card small {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
    letter-spacing: -0.02em;
  }

  .verified-title {
    margin: 0 0 0.1rem;
    font-size: clamp(1.9rem, 3vw, 2.15rem);
    font-weight: 600;
    line-height: 0.92;
    color: #14383e;
  }

  .verified-subtitle {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #14383e;
  }

  .brand-block {
    display: flex;
    align-items: center;
    gap: 0.72rem;
  }

  .mit-mark {
    display: grid;
    grid-template-columns: repeat(6, 0.38rem);
    align-items: end;
    gap: 0.14rem;
    height: 2.5rem;
  }

  .mit-mark span {
    display: block;
    background: #1d2429;
    border-radius: 0.03rem;
  }

  .mit-mark .b1,
  .mit-mark .b3,
  .mit-mark .b4 {
    height: 2.35rem;
  }

  .mit-mark .b2,
  .mit-mark .b5,
  .mit-mark .b6 {
    height: 1.55rem;
  }

  .mit-mark .b2 {
    height: 1.72rem;
  }

  .brand-text {
    display: flex;
    align-items: center;
  }

  .brand-text span {
    font-size: 2.1rem;
    font-weight: 700;
    color: #1d2429;
  }

  .watermark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(4rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.08em;
    color: rgba(90, 106, 109, 0.13);
    transform: rotate(-48deg) translateY(-0.3rem);
    user-select: none;
    pointer-events: none;
  }

  .certificate-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 178px;
    gap: 0.9rem 1.45rem;
    align-items: start;
    min-height: 20rem;
  }

  .main-copy {
    padding-top: 1.3rem;
    max-width: 28rem;
  }

  .intro {
    margin: 0 0 0.9rem;
    font-size: 0.74rem;
    color: #344e54;
  }

  h1 {
    font-size: clamp(1.9rem, 3vw, 2.45rem);
    line-height: 1;
    color: #14383e;
    margin-bottom: 0.7rem;
  }

  .completion {
    margin: 0 0 0.62rem;
    font-size: 0.73rem;
    color: #274c52;
  }

  h2 {
    font-size: clamp(2rem, 3.5vw, 2.95rem);
    line-height: 0.95;
    color: #14383e;
    max-width: 27rem;
    text-wrap: balance;
    margin-bottom: 0.95rem;
  }

  .description {
    max-width: 25rem;
    font-size: 0.74rem;
    color: #35575d;
  }

  .signature-panel {
    display: flex;
    flex-direction: column;
    gap: 2.65rem;
    padding-top: 0.6rem;
  }

  .signature-card {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .signature {
    font-family: "Snell Roundhand", "Apple Chancery", "Brush Script MT", cursive;
    font-size: 2rem;
    line-height: 1;
    color: #9d9fa4;
  }

  .signature-card strong {
    font-size: 0.78rem;
    color: #14383e;
    font-weight: 700;
  }

  .signature-card small {
    font-size: 0.62rem;
    color: #6d7f84;
  }

  .signature-card small.org {
    font-style: italic;
  }

  .certificate-foot {
    position: relative;
    z-index: 1;
    padding-top: 1.25rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.6rem;
    align-items: end;
  }

  .badge-area {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.95rem;
    height: 1.15rem;
    padding-inline: 0.22rem;
    background: transparent;
    color: #1a2226;
    border: 1px solid #d5d9db;
    border-radius: 0.16rem;
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: -0.08em;
    gap: 0.02rem;
  }

  .seal span:last-child {
    color: #0d5b64;
  }

  .seal-copy {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .seal-copy strong {
    font-size: 0.73rem;
    color: #17383d;
  }

  .seal-copy span {
    font-size: 0.69rem;
    color: #6d7f84;
  }

  .meta-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, auto));
    gap: 0.85rem 1.7rem;
    justify-content: start;
    align-items: end;
  }

  .meta-grid div {
    display: flex;
    flex-direction: column;
    gap: 0.16rem;
  }

  dt {
    font-size: 0.72rem;
    font-weight: 700;
    color: #435f64;
  }

  dd {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #18393f;
    word-break: break-word;
  }

  @media (width <= 900px) {
    .certificate-sheet {
      aspect-ratio: auto;
      padding: 1.4rem;
    }

    .certificate-grid,
    .certificate-foot {
      grid-template-columns: 1fr;
    }

    .signature-panel {
      gap: 1.3rem;
      padding-top: 0;
    }

    .main-copy {
      padding-top: 0.4rem;
    }

    .meta-grid {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }

  @media (width <= 700px) {
    .page-shell {
      padding: 1rem;
    }

    .topbar,
    .certificate-head {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
